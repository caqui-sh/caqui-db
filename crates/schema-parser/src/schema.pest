WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* }

ident      = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

// Differentiate scalar primitives vs custom types
scalar     = { "String" | "Int" | "Float" | "Boolean" | "DateTime" }
custom     = { ident }

// Capture arrays natively (e.g., String[])
is_array   = { "[]" }
is_optional = { "?" }
field_type = { (scalar | custom) ~ is_array? ~ is_optional? }

// Values can be functions, strings, numbers, or array literals
string_lit  = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
number      = { ASCII_DIGIT+ }
attr_func   = { ident ~ "()" }
attr_array  = { "[" ~ ident? ~ ("," ~ ident)* ~ "]" }
attr_val    = { attr_func | attr_array | string_lit | number | "true" | "false" | ident }

// Named arguments (e.g., fields: [authorId])
named_arg   = { ident ~ ":" ~ attr_val }
attr_param  = { named_arg | attr_val }
attr_args   = { "(" ~ attr_param ~ ("," ~ attr_param)* ~ ")" }

// Differentiate field-level (@) from block-level (@@)
field_attr  = { "@" ~ ident ~ attr_args? }
block_attr  = { "@@" ~ ident ~ attr_args? }

field_def  = { ident ~ ":" ~ field_type ~ field_attr* }
extends_clause = { "extends" ~ ident ~ ("," ~ ident)* ~ ","? }
base_def   = { "base" ~ ident ~ extends_clause? ~ "{" ~ field_def* ~ "}" }
model_def  = { "model" ~ ident ~ extends_clause? ~ "{" ~ field_def* ~ block_attr* ~ "}" }

// Capture explicit Polymorphic Unions (e.g., union SearchResult = Article | User)
union_def  = { "union" ~ ident ~ "=" ~ ident ~ ("|" ~ ident)* }

schema     = { SOI ~ (model_def | base_def | union_def)* ~ EOI }
